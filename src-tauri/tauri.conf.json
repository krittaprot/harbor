{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Harbor",
  "mainBinaryName": "harbor-app",
  "version": "1.5.3",
  "identifier": "com.ode.harbor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Harbor",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "macOS": {
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    },
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2NUFGRDZEOTg3OENERjgKUldUNHpYaVliZjFhWmc5cGgvT3FlOTkydzRwdTQ5TysvRWwzYUVuNUtjaElXQVQ5YVlDRnNTcXkK",
      "endpoints": [
        "https://github.com/krittaprot/harbor/releases/latest/download/latest.json"
      ]
    }
  }
}
